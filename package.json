{
  "name": "nastolki-online",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run start:dev -w @nastolki/server",
    "dev:mobile": "npm run start -w @nastolki/mobile",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "setup": "sh scripts/setup.sh",
    "db:up": "docker compose up -d"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "expo-auth-session": "~6.0.3"
  }
}
