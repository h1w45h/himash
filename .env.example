APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/fesi.sqlite3

# --- Telegram (create a bot with @BotFather; get your numeric id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=            # comma-separated numeric ids; empty = everybody denied

# --- Football data: api-football (https://dashboard.api-football.com, header x-apisports-key)
#     or football-data-org (https://www.football-data.org, header X-Auth-Token; no odds/events) ---
FOOTBALL_DATA_PROVIDER=api-football
FOOTBALL_DATA_API_KEY=
# ODDS_PROVIDER: api-football | football-data-uk (free, no key; 1X2 + O/U2.5 only) | api-football+football-data-uk
# Exact-score odds: only api-football is implemented. Reuses FOOTBALL_DATA_API_KEY unless ODDS_API_KEY is set.
ODDS_PROVIDER=api-football
ODDS_API_KEY=

INTEGRITY_SOURCE_REFRESH_HOURS=12
LIVE_POLL_SECONDS=30
LIVE_STALE_SECONDS=120
ODDS_STALE_SECONDS=900
MODEL_VERSION=dixon-coles-v1
MAX_SCORE_GOALS=8
MIN_TRAINING_MATCHES=60
MIN_TEAM_MATCHES=5
TIME_DECAY_XI=0.0018
EV_MIN_THRESHOLD=0.05
MIN_MODEL_CONFIDENCE=0.60
# Value alerts stay off until a walk-forward backtest passes the calibration gate.
EV_ALERTS_ENABLED=false
COMMANDS_PER_MINUTE=20
MAX_TIPS=10
# Experimental composite formula (scripts/composite_fit.py); off because it showed no significant gain.
COMPOSITE_ENABLED=false
