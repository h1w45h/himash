# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# ID закрытого канала с сигналами (бот должен быть в нём админом с правом банить и приглашать)
CHANNEL_ID=-1001234567890
# Telegram ID админов через запятую
ADMIN_IDS=111111111
# Тарифы: код:дней:цена_в_звёздах:название, через точку с запятой
PLANS=week:7:250:Неделя;month:30:750:Месяц;quarter:90:1900:3 месяца
# За сколько дней до конца подписки напоминать
REMIND_DAYS_BEFORE=3
# Как часто проверять подписки, в секундах
CHECK_INTERVAL_SECONDS=600
# Путь к базе SQLite
DB_PATH=data/bot.db
