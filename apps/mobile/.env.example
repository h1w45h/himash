# Адрес сервера. Для телефона/эмулятора укажите IP компьютера в сети (не localhost):
# Android-эмулятор: http://10.0.2.2:3000, iOS-симулятор: http://localhost:3000, телефон: http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Пусто — локальный вход по нику. Для Google/Apple/VK/email задайте ключ Clerk.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
