DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nastolki
REDIS_URL=redis://localhost:6379
PORT=3000

# --- Авторизация ---
# Локальный режим: оставьте Clerk-переменные пустыми — сервер примет токены вида `dev:<ник>`.
# Боевой режим: заполните ключи Clerk (см. docs/AUTH.md); вход по нику в production отключён.
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_WEBHOOK_SECRET=
# DEV_AUTH=true  # принудительно включить вход по нику (только для стендов!)
