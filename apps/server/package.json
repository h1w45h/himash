{
  "name": "@nastolki/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node -r @swc-node/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node -r @swc-node/register prisma/seed.ts"
  },
  "prisma": { "seed": "node -r @swc-node/register prisma/seed.ts" },
  "dependencies": {
    "@nastolki/game-engine": "*",
    "@nastolki/shared": "*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^6.0.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.26",
    "@types/node": "^20.16.10",
    "prisma": "^6.0.0",
    "typescript": "~5.3.3",
    "vitest": "^2.1.2"
  }
}
